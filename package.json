{
  "name": "fullstack-studio",
  "version": "0.1.0",
  "private": true,
  "description": "FullStack Studio V10 - Build Anything. Visually. Without Limits.",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
