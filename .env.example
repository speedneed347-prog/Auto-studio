# ---------- API (apps/api) - set in Render dashboard, NEVER commit real values ----------
NODE_ENV=development
PORT=8080
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
FIREBASE_PROJECT_ID=your-firebase-project-id
# Entire service-account JSON on ONE line (server-side only). Leave empty locally if you use
# `gcloud auth application-default login`.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---------- Web (apps/web) - these are public client config values, not secrets ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Empty in dev (Vite proxies /api to localhost:8080). Set to your Render API URL in production.
VITE_API_URL=
